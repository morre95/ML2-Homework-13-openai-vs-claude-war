# Copy to .env. Only the proxy container ever sees the real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Build phase (equal for both boxes)
BUILD_TOKEN_BUDGET=2000000
# all = every processed token counts (incl. cache reads); uncached = cache reads are free
BUDGET_MODE=all
WALL_CLOCK_SECONDS=21600
MAX_SESSIONS=30
MIN_REMAINING_TOKENS=20000

# Builder CLI models (empty = each CLI's default)
CLAUDE_BUILDER_MODEL=
CODEX_BUILDER_MODEL=
